/target
/rsxcore/target
/radsex-cli/target
*.swp
*.swo
*~
.DS_Store

# pixi
.pixi/
# The workspace lock stays in git: rsx-cli embeds it with include_bytes! for
# the reproducibility archive, so a clean clone cannot build without it.
# Sub-project locks are environment scratch and stay out.
pixi.lock
!/pixi.lock

# Build artifacts
# rsxcore/include/rsx.h stays in git: cbindgen only writes it under the
# non-default gen-header feature, and test_header_sync includes it at compile
# time, so a clean clone cannot build the test suite without it. Regenerate
# with `cargo build -p rsxcore --features gen-header` and commit the result.

# Generated documentation
# orgmode/ (in docs/orgmode/) is the source of truth.
# docs/export.el (run via `pixi run -e docs mkrst`) exports .org -> .rst into docs/source/.
# Only the following under docs/source/ are hand-maintained:
#   - conf.py
#   - _static/
#   - _templates/
#
# Everything else under docs/source/ is a build artifact and must stay out of git.
/docs/build/
/docs/_build/
/docs/source/**

# Re-include the manual parts of docs/source/
!/docs/source/conf.py
!/docs/source/references.bib
!/docs/source/_static/
!/docs/source/_static/**
!/docs/source/_templates/
!/docs/source/_templates/**

# Generated Rust API documentation
# Produced by sphinx-rustdocgen + sphinxcontrib_rust (see setup-rustdocgen + gen-rust-api tasks
# in pixi.toml and rust_crates + rust_doc_dir in docs/source/conf.py).
# Generated to api/rust/rsx_core/ at repo root. The .. rust:crate::rsx_core directive in the
# reference page uses this to render the API docs. Do not commit the generated tree.
/docs/source/reference/rust-api/rsx_core/

# IDE
.vscode/
.idea/

# ASV
.asv/

# Benchmark intermediate outputs (keep data/ and results/ in git)
benchmarks/data/*/cpp_*.tsv
benchmarks/data/*/rust_*.tsv
benchmarks/data/*/*.amb
benchmarks/data/*/*.ann
benchmarks/data/*/*.bwt
benchmarks/data/*/*.pac
benchmarks/data/*/*.sa
benchmarks/data-regenerated/
benchmarks/literature-workdir/
repro/benchmarks/figshare_package/

# Local project context
.project-ctx.toml
*.so
*.dylib
*.pyd

# Sphinx build subprojects
/subprojects/

# Copied from docs/figures/ by pixi sync-doc-figures (do not commit duplicates)
/docs/source/_static/figures/

# Lean build
**/.lake/


# Coverage outputs (generated by scripts/run_coverage_*.sh)
/lcov.info
/rust_codecov.json
/python_lcov.info
/python_coverage.xml
/r_coverage.xml
/.venv-coverage-python/
*.profraw

# local review notes, never published
.reviews/
