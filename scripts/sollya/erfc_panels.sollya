/*
 * Panelled minimax for erfc(t) on [0, 6), emitted as Rust.
 *
 * A single degree-40 fit across the whole interval is accurate as a polynomial
 * and useless as a routine: Horner intermediates reach 6^40 ~ 1.3e31 and
 * round-off buries the approximation. Three changes fix that.
 *
 *   1. Split [0, 6) into narrow panels so each fit needs a low degree.
 *   2. Fit in the centred variable u = t - c, so |u| <= w/2 and every monomial
 *      stays O(1). This is what bounds the evaluation error.
 *   3. Use fpminimax rather than remez, so the coefficients are already doubles
 *      and the reported error is the error of the coefficients we ship.
 *
 * Relative error is the target: a marker call compares p against a Bonferroni
 * threshold that can sit at 1e-7 or lower, so relative accuracy is what decides
 * a call. For t >= 6, erfc(t) < 2.2e-17, under the 1e-16 p-value floor.
 *
 * Run: pixi run -- sollya < erfc_panels.sollya
 */

prec = 250!;
verbosity = 0!;

w = 0.25;
d = 14;
n = 24;

display = decimal!;
write("// Generated by scripts/sollya/erfc_panels.sollya -- do not edit.\n");
write("// erfc(t) on [0, ", n * w, ") as ", n, " panels of width ", w,
      ", degree ", d, ",\n// fitted with fpminimax in the centred variable u = t - c.\n");

worst = 0;
for k from 0 to n - 1 do {
  cc = k * w + w / 2;
  gg = erfc(x + cc);
  pp = fpminimax(gg, d, [|D...|], [-w/2; w/2], relative);
  ee = dirtyinfnorm((gg - pp)/gg, [-w/2; w/2]);
  if (ee > worst) then { worst = ee; };
};
write("// Worst relative error over the whole range: ", worst, "\n");
write("pub(crate) const ERFC_PANEL_WIDTH: f64 = ", w, ";\n");
write("pub(crate) const ERFC_PANELS: usize = ", n, ";\n");
write("pub(crate) const ERFC_DEGREE: usize = ", d, ";\n");
write("pub(crate) const ERFC_PANEL_COEFFS: [[u64; ", d + 1, "]; ", n, "] = [\n");
for k from 0 to n - 1 do {
  cc = k * w + w / 2;
  gg = erfc(x + cc);
  pp = fpminimax(gg, d, [|D...|], [-w/2; w/2], relative);
  ee = dirtyinfnorm((gg - pp)/gg, [-w/2; w/2]);
  write("    // panel ", k, ": t in [", k*w, ", ", (k+1)*w, "), rel err ", ee, "\n");
  write("    [\n");
  for j from 0 to d do {
    write("        "); printdouble(coeff(pp, j)); write(",\n");
  };
  write("    ],\n");
};
write("];\n");
